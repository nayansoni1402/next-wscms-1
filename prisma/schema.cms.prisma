generator client {
    provider = "prisma-client-js"
    output   = "../generated/cms"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL_CMS")
}

model oc_video {
    id           Int     @id @default(autoincrement())
    video_url    String  @db.VarChar(255)
    status       String  @db.VarChar(10)
    sort_order   Int     @default(0)
    banner_video Boolean @default(false)

    @@map("__oc_video")
}

model app_detail {
    id          Int      @id @default(autoincrement())
    device_id   String   @db.Text
    device_type String   @db.VarChar(10)
    user_id     Int
    islogin     String   @db.VarChar(10)
    createdat   DateTime @db.DateTime(0)

    @@index([user_id], map: "NewIndex1")
}

model app_lead_details {
    id          Int    @id @default(autoincrement())
    crm_lead_id Int
